[Unit]
Description=EdgeSwarm Linux Recommended Model Provisioner
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=edgeswarm
Group=edgeswarm
WorkingDirectory=/opt/edgeswarm-node
EnvironmentFile=-/etc/edgeswarm-node.env
RuntimeDirectory=edgeswarm-node-model-provisioner
RuntimeDirectoryMode=0755
TimeoutStartSec=0
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/opt/edgeswarm-node/runtime/bin/edgeswarm-python /opt/edgeswarm-node/scripts/edgeswarm_linux_model_auto_provision.py
ExecStartPost=+/opt/edgeswarm-node/scripts/edgeswarm_linux_model_restart_if_needed.sh
