[Unit]
Description=EdgeSwarm Linux Node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=edgeswarm
Group=edgeswarm
WorkingDirectory=/opt/edgeswarm-node
EnvironmentFile=-/etc/edgeswarm-node.env
ExecStart=/opt/edgeswarm-node/.venv/bin/python /opt/edgeswarm-node/edgeswarm_node.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
